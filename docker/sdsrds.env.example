# Sample RDS deployment secrets file.
#
# Copy this file to docker/.sdsrds.env and fill in real values locally.
# Do not commit docker/.sdsrds.env.

# Required by docker/deploy_helm_rds.sh.
MYSQL_PASSWORD=
OMEKA_ADMIN_PASSWORD=
OIDC_CLIENT_SECRET=

# Optional: image registry credentials for pulling registry.docker.iu.edu images.
# Leave these blank when IMAGE_PULL_SECRET points to an existing Kubernetes secret.
IMAGE_REGISTRY_USERNAME=
IMAGE_REGISTRY_PASSWORD=
IMAGE_REGISTRY_EMAIL=

# Optional: name of an existing image pull secret in the RDS namespace.
IMAGE_PULL_SECRET=
